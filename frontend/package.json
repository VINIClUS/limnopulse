{
  "name": "limnopulse-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:visual": "playwright test",
    "test:local": "playwright test --config playwright.local.config.ts",
    "preview": "vite preview --host 127.0.0.1 --port 3000",
    "format": "prettier --write src e2e scripts *.ts",
    "compare:visual": "node scripts/compare-visual.mjs",
    "test:production": "playwright test --config playwright.production.config.ts"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@tanstack/react-query": "^5.90.0",
    "aws-amplify": "^6.15.0",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.13.0",
    "recharts": "^3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "jsdom": "^28.0.0",
    "pixelmatch": "^7.1.0",
    "prettier": "^3.9.8",
    "sharp": "^0.35.4",
    "typescript": "~5.9.3",
    "vite": "^7.3.0",
    "vitest": "^4.0.0"
  }
}
