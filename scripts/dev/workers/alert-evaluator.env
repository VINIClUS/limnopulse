# Local settings for `scripts/dev/run_worker.sh alert-evaluator`: the emulators on their host ports
# (docker compose up -d ...). A variable already set in the caller's environment wins.
APP_ENV=local
AWS_REGION=us-east-1
AWS_EC2_METADATA_DISABLED=true
DYNAMODB_DOMAIN_TABLE=LimnopulseDomain
DYNAMODB_ENDPOINT_URL=http://127.0.0.1:8001
INFLUXDB_URL=http://127.0.0.1:8086
INFLUXDB_TOKEN=local-dev-token
INFLUXDB_ORG=limnopulse
INFLUXDB_BUCKET_RAW=limnopulse_raw
TELEGRAM_DELIVERY_ENABLED=true
