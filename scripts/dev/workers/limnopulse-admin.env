# Local settings for `scripts/dev/run_worker.sh limnopulse-admin`: the emulators on their host ports
# (docker compose up -d ...). A variable already set in the caller's environment wins.
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
AWS_EC2_METADATA_DISABLED=true
AWS_REGION=us-east-1
DYNAMODB_DOMAIN_TABLE=LimnopulseDomain
DYNAMODB_ENDPOINT_URL=http://127.0.0.1:8001
