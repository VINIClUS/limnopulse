# Local settings for `scripts/dev/run_worker.sh notification-relay`: the emulators on their host ports
# (docker compose up -d ...). A variable already set in the caller's environment wins.
APP_ENV=local
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
AWS_EC2_METADATA_DISABLED=true
AWS_REGION=us-east-1
DYNAMODB_DOMAIN_TABLE=LimnopulseDomain
DYNAMODB_ENDPOINT_URL=http://127.0.0.1:8001
SQS_ENDPOINT_URL=http://127.0.0.1:9324
SQS_NOTIFICATION_JOBS_URL=http://127.0.0.1:9324/000000000000/limnopulse-notification-jobs
SQS_TELEGRAM_JOBS_URL=http://127.0.0.1:9324/000000000000/limnopulse-telegram-notification-jobs
TELEGRAM_DELIVERY_ENABLED=true
LIMNOPULSE_WEB_URL=http://localhost:3000
