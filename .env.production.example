# Template for /opt/limnopulse/.env on the VPS. Created out of band by a
# human during Fase 1 bootstrap — never generated or touched by CI. Values
# here are placeholders; real values come from Fase 0's `tofu apply` outputs
# and from AWS IAM user credentials, and are pasted in manually.
#
# This file is consumed two ways at once (see compose.production.yaml):
#   1. `docker compose --env-file .env ...` reads it for ${VAR} interpolation
#      in compose.production.yaml (IMAGE_TAG comes from .env.image instead;
#      INFLUXDB_INIT_* below are interpolation-only, read by the influxdb
#      service definition, not by the API).
#   2. `env_file: /opt/limnopulse/.env` on the api service injects it into
#      the API container's process environment, parsed by
#      src/limnopulse_api/core/config.py.
#
# Settings that MUST be exactly these literals or the API refuses to boot
# (see validate_auth_mode_for_environment in core/config.py):
APP_ENV=prod
AUTH_MODE=cognito

# Do not set DYNAMODB_ENDPOINT_URL or SQS_ENDPOINT_URL here at all — even an
# empty value changes API behavior. Their absence means "talk to real AWS."

AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=REPLACE_WITH_LIMNOPULSE_API_IAM_USER_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_LIMNOPULSE_API_IAM_USER_SECRET_KEY

# From `tofu apply` outputs (infra/opentofu), Fase 0.
COGNITO_USER_POOL_ID=REPLACE_WITH_TOFU_OUTPUT_cognito_user_pool_id
COGNITO_CLIENT_ID=REPLACE_WITH_TOFU_OUTPUT_cognito_client_id
COGNITO_ISSUER=REPLACE_WITH_TOFU_OUTPUT_cognito_issuer
DYNAMODB_DOMAIN_TABLE=REPLACE_WITH_TOFU_OUTPUT_dynamodb_domain_table
DYNAMODB_AUDIT_TABLE=REPLACE_WITH_TOFU_OUTPUT_dynamodb_audit_table

# Telegram webhook: disabled for the Fase 1 core deploy (API + frontend +
# Redis + InfluxDB only — see infra/opentofu/env/cloud.tfvars.example,
# telegram_webhook = false). Leave TELEGRAM_WEBHOOK_ENABLED unset/false and
# the two lines below commented out; the API boots without them. Flip to
# true together with the OpenTofu flag once the Fase 2 Proxmox worker and
# real bot are being wired up.
# TELEGRAM_WEBHOOK_ENABLED=true
# TELEGRAM_WEBHOOK_SECRET_ARN=REPLACE_WITH_TOFU_OUTPUT_telegram_webhook_secret_arn
# TELEGRAM_BOT_USERNAME=REPLACE_WITH_REAL_BOT_USERNAME
#
# Presence of TELEGRAM_WEBHOOK_SECRET (the raw value, as opposed to the ARN
# above) is a fatal error when APP_ENV=prod and the webhook is enabled — the
# API reads the secret itself from Secrets Manager at runtime, never a raw
# value, outside local/test.

# Redis and InfluxDB point at the internal compose network, not the public
# influx.limnopulse.com host (that hostname exists only for the Proxmox LXC
# to reach InfluxDB across sites — see compose.production.yaml comments).
REDIS_URL=redis://redis:6379/0
INFLUXDB_URL=http://influxdb:8086
INFLUXDB_TOKEN=REPLACE_WITH_A_GENERATED_INFLUXDB_ADMIN_TOKEN
INFLUXDB_ORG=limnopulse
INFLUXDB_BUCKET_RAW=limnopulse_raw
TELEMETRY_DEFAULT_RANGE=-1h
TELEMETRY_MAX_LIMIT=1000

JWKS_CACHE_TTL_SECONDS=43200
MEMBERSHIP_CACHE_TTL_SECONDS=120
DEVICE_CACHE_TTL_SECONDS=1800
TENANT_SETTINGS_CACHE_TTL_SECONDS=1800

# Interpolation-only, consumed by the influxdb service in
# compose.production.yaml (DOCKER_INFLUXDB_INIT_*), not by the API. Only
# used on first boot of a fresh influxdb_data volume.
INFLUXDB_INIT_USERNAME=limnopulse
INFLUXDB_INIT_PASSWORD=REPLACE_WITH_A_GENERATED_PASSWORD
