FROM python:3.12-slim-trixie@sha256:4840d514c583a4d3d8cad3940e68dee6f0f6f3635c12fcd0a3d74c21a5b93a54 AS build

WORKDIR /src
COPY --from=ghcr.io/astral-sh/uv:0.11.28 /uv /uvx /usr/local/bin/
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PROJECT_ENVIRONMENT=/app/.venv

COPY pyproject.toml uv.lock ./
RUN uv sync --locked --no-dev --no-install-project

COPY src ./src
RUN uv sync --locked --no-dev

FROM python:3.12-slim-trixie@sha256:4840d514c583a4d3d8cad3940e68dee6f0f6f3635c12fcd0a3d74c21a5b93a54

RUN apt-get update \
    && apt-get install -y --no-install-recommends zlib1g=1:1.3.dfsg+really1.3.1-1+deb13u1 \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd --gid 65532 nonroot \
    && useradd --uid 65532 --gid nonroot --no-create-home --shell /usr/sbin/nologin nonroot

COPY --from=build /app/.venv /app/.venv
COPY --from=build /src/src /app/src

WORKDIR /app
ENV PATH="/app/.venv/bin:$PATH" PYTHONPATH="/app/src"

USER nonroot:nonroot
EXPOSE 8000
STOPSIGNAL SIGTERM
HEALTHCHECK NONE
ENTRYPOINT ["uvicorn", "limnopulse_api.main:app", "--host", "0.0.0.0", "--port", "8000"]
