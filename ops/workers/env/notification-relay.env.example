# Template for /etc/limnopulse/workers/notification-relay.env on the VPS (root:root,
# 0600), read by limnopulse-notification-relay.service through EnvironmentFile=.
# Placeholders come from the OpenTofu outputs (infra/opentofu). Rules for every worker env
# file (ops/workers/README.md):
# - Non-secret settings only. The AWS keys arrive through LoadCredential= from
#   /etc/limnopulse/workers/credentials/notification-relay/, never from this file.
# - Never set GOTRACEBACK or LIMNOPULSE_SUPERVISOR: the unit sets them, and a value here
#   would override the unit.
# - Never set an *_ENDPOINT_URL: it points the AWS clients at an emulator with static
#   local keys.
APP_ENV=prod
AWS_REGION=us-east-2
DYNAMODB_DOMAIN_TABLE=REPLACE_WITH_TOFU_OUTPUT_dynamodb_domain_table
SQS_NOTIFICATION_JOBS_URL=REPLACE_WITH_TOFU_OUTPUT_notification_jobs_queue_url
# Must be explicit in prod. With it on, the two settings below are required as well.
TELEGRAM_DELIVERY_ENABLED=false
# SQS_TELEGRAM_JOBS_URL=REPLACE_WITH_TOFU_OUTPUT_telegram_notification_jobs_queue_url
# LIMNOPULSE_WEB_URL=REPLACE_WITH_THE_PUBLIC_WEB_URL
