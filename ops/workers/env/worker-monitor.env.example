# Template for /etc/limnopulse/workers/worker-monitor.env on the VPS (root:root, 0600),
# read by limnopulse-worker-monitor.service through EnvironmentFile=. Placeholders come
# from the OpenTofu outputs (infra/opentofu). Rules for every worker env file
# (ops/workers/README.md):
# - Non-secret settings only. The AWS keys arrive through LoadCredential= from
#   /etc/limnopulse/workers/credentials/worker-monitor/, never from this file.
# - Never set GOTRACEBACK or LIMNOPULSE_SUPERVISOR: the unit sets them, and a value here
#   would override the unit.
# - Never set an *_ENDPOINT_URL: it points the AWS clients at an emulator with static
#   local keys.
# Without a region the monitor exits 78.
AWS_REGION=us-east-2
