# Template for /etc/limnopulse/workers/email-worker.env on the VPS (root:root, 0600), read
# by limnopulse-email-worker.service through EnvironmentFile=. Placeholders come from the
# OpenTofu outputs (infra/opentofu). Rules for every worker env file
# (ops/workers/README.md):
# - Non-secret settings only. The AWS keys arrive through LoadCredential= from
#   /etc/limnopulse/workers/credentials/email-worker/, never from this file.
# - Never set GOTRACEBACK or LIMNOPULSE_SUPERVISOR: the unit sets them, and a value here
#   would override the unit.
# - Never set an *_ENDPOINT_URL: it points the AWS clients at an emulator with static
#   local keys.
APP_ENV=prod
AWS_REGION=us-east-2
DYNAMODB_DOMAIN_TABLE=REPLACE_WITH_TOFU_OUTPUT_dynamodb_domain_table
SQS_NOTIFICATION_JOBS_URL=REPLACE_WITH_TOFU_OUTPUT_notification_jobs_queue_url
SES_FROM_EMAIL=REPLACE_WITH_THE_VERIFIED_SES_SENDER_ADDRESS
SES_CONFIGURATION_SET_NAME=REPLACE_WITH_TOFU_OUTPUT_ses_configuration_set_name
# Staging and prod accept only the real SES sender.
NOTIFICATION_EMAIL_SENDER_MODE=aws
# Must be explicit in staging and prod: SES calls per second. 1 is the SES sandbox maximum;
# raise it to the account's sending quota once SES production access is granted. A rate so
# low that one wait plus the 15 s provider timeout reaches the 90 s stall limit exits 78.
NOTIFICATION_MAX_SEND_RATE=1
