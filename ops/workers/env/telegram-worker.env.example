# Template for /etc/limnopulse/workers/telegram-worker.env on the VPS (root:root, 0600),
# read by limnopulse-telegram-worker.service through EnvironmentFile=. Placeholders come
# from the OpenTofu outputs (infra/opentofu). Rules for every worker env file
# (ops/workers/README.md):
# - Non-secret settings only. The AWS keys and the Redis password (`redis-password`)
#   arrive through LoadCredential= from
#   /etc/limnopulse/workers/credentials/telegram-worker/, never from this file.
# - Never set GOTRACEBACK or LIMNOPULSE_SUPERVISOR: the unit sets them, and a value here
#   would override the unit.
# - Never set an *_ENDPOINT_URL: it points the AWS clients at an emulator with static
#   local keys.
APP_ENV=prod
AWS_REGION=us-east-2
DYNAMODB_DOMAIN_TABLE=REPLACE_WITH_TOFU_OUTPUT_dynamodb_domain_table
SQS_TELEGRAM_JOBS_URL=REPLACE_WITH_TOFU_OUTPUT_telegram_notification_jobs_queue_url
# The worker refuses to start unless this is true.
TELEGRAM_DELIVERY_ENABLED=true
# The bot token stays in Secrets Manager; never set TELEGRAM_BOT_TOKEN here.
TELEGRAM_BOT_TOKEN_SECRET_ARN=REPLACE_WITH_TOFU_OUTPUT_telegram_bot_token_secret_arn
# Redis on the host loopback, with a password, once this worker is enabled (ADR-020).
REDIS_ADDR=127.0.0.1:6379
