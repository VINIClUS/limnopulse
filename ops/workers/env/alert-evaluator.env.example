# Template for /etc/limnopulse/workers/alert-evaluator.env on the VPS (root:root, 0600),
# read by limnopulse-alert-evaluator.service through EnvironmentFile=. Placeholders come
# from the OpenTofu outputs (infra/opentofu). Rules for every worker env file
# (ops/workers/README.md):
# - Non-secret settings only. The AWS keys and the InfluxDB token (`influxdb-token`)
#   arrive through LoadCredential= from
#   /etc/limnopulse/workers/credentials/alert-evaluator/, never from this file.
# - Never set GOTRACEBACK or LIMNOPULSE_SUPERVISOR: the unit sets them, and a value here
#   would override the unit.
# - Never set an *_ENDPOINT_URL: it points the AWS clients at an emulator with static
#   local keys.
APP_ENV=prod
AWS_REGION=us-east-2
DYNAMODB_DOMAIN_TABLE=REPLACE_WITH_TOFU_OUTPUT_dynamodb_domain_table
# InfluxDB is published on the host loopback only (compose.production.yaml).
INFLUXDB_URL=http://127.0.0.1:8086
INFLUXDB_ORG=limnopulse
INFLUXDB_BUCKET_RAW=limnopulse_raw
# Must be explicit in prod. Turn it on together with the relay and the Telegram worker.
TELEGRAM_DELIVERY_ENABLED=false
# Must be explicit in prod: the evaluator refuses to start on its built-in data-quality
# defaults. These are those defaults (internal/alertevaluator/config.go); match them to the
# devices' publish interval and the rules' tolerance before you enable the timer.
ALERT_EVALUATOR_EXPECTED_SAMPLE_INTERVAL=10s
ALERT_EVALUATOR_MIN_COVERAGE_RATIO=0.8
ALERT_EVALUATOR_MIN_POINTS=3
ALERT_EVALUATOR_ALLOWED_LATENESS=15s
ALERT_EVALUATOR_MAX_SAMPLE_AGE=30s
