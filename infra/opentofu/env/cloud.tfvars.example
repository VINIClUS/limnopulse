project_name = "limnopulse"
environment  = "cloud"
aws_region   = "us-east-2"

dynamodb_domain_table = "LimnopulseDomain"
dynamodb_audit_table  = "LimnopulseAudit"

cognito_user_pool_name = "limnopulse-users"
cognito_client_name    = "limnopulse-app"

notification_jobs_queue_name = "limnopulse-notification-jobs"
notification_jobs_dlq_name   = "limnopulse-notification-jobs-dlq"
telegram_notification_jobs_queue_name = "limnopulse-telegram-notification-jobs"
telegram_notification_jobs_dlq_name   = "limnopulse-telegram-notification-jobs-dlq"
telegram_bot_token_secret_name        = "limnopulse/telegram/bot-token"
telegram_webhook_secret_name          = "limnopulse/telegram/webhook-secret"

ses_events_queue_name        = "limnopulse-ses-events"
ses_events_dlq_name           = "limnopulse-ses-events-dlq"
ses_events_routing_dlq_name   = "limnopulse-ses-events-routing-dlq"
ses_configuration_set_name   = "limnopulse-notifications"
ses_eventbridge_rule_name     = "limnopulse-ses-events"

redis_url    = ""
influxdb_url = ""
