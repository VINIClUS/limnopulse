APP_ENV=local
AUTH_MODE=dev
AWS_REGION=us-east-2
COGNITO_USER_POOL_ID=us-east-2_XXXXXXXXX
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
COGNITO_ISSUER=https://cognito-idp.us-east-2.amazonaws.com/us-east-2_XXXXXXXXX
DYNAMODB_DOMAIN_TABLE=LimnopulseDomain
DYNAMODB_AUDIT_TABLE=LimnopulseAudit
DYNAMODB_ENDPOINT_URL=http://localhost:8001
SQS_ENDPOINT_URL=http://localhost:9324
SQS_NOTIFICATION_JOBS_URL=http://localhost:9324/000000000000/limnopulse-notification-jobs
SQS_TELEGRAM_JOBS_URL=http://localhost:9324/000000000000/limnopulse-telegram-notification-jobs
SQS_SES_EVENTS_URL=http://localhost:9324/000000000000/limnopulse-ses-events
SES_FROM_EMAIL=alerts@example.test
SES_CONFIGURATION_SET_NAME=limnopulse-notifications
NOTIFICATION_EMAIL_SENDER_MODE=success
NOTIFICATION_FAKE_MESSAGE_ID=provider_message_local_example
NOTIFICATION_MAX_SEND_RATE=10
TELEGRAM_DELIVERY_ENABLED=true
TELEGRAM_BOT_USERNAME=limnopulse_local_bot
TELEGRAM_WEBHOOK_SECRET=local-telegram-webhook-secret
TELEGRAM_BOT_TOKEN=123456:local-test-token
TELEGRAM_BOT_API_BASE_URL=http://localhost:8089
TELEGRAM_GLOBAL_RATE=25
TELEGRAM_GLOBAL_BURST=25
TELEGRAM_DESTINATION_RATE=1
TELEGRAM_DESTINATION_BURST=1
LIMNOPULSE_WEB_URL=http://localhost:3000
REDIS_URL=redis://localhost:6379/0
REDIS_ADDR=localhost:6379
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=local-dev-token
INFLUXDB_ORG=limnopulse
INFLUXDB_BUCKET_RAW=limnopulse_raw
TELEMETRY_DEFAULT_RANGE=-1h
TELEMETRY_MAX_LIMIT=1000
JWKS_CACHE_TTL_SECONDS=43200
MEMBERSHIP_CACHE_TTL_SECONDS=120
DEVICE_CACHE_TTL_SECONDS=1800
TENANT_SETTINGS_CACHE_TTL_SECONDS=1800

# M1 rollout flags (default off): mount the /v2 domain API; dual-write v1 Pond/Device to v2 records
API_V2_ENABLED=false
V1_POND_DEVICE_PROJECTION_ENABLED=false

# P2 canonical telemetry switches (default off; P2 ships dark, see README)
# Write observation_numeric points / eligible legacy water_quality points (dev CLI only in P2)
TELEMETRY_V2_WRITE_ENABLED=false
TELEMETRY_LEGACY_DUAL_WRITE_ENABLED=false
# Mount the three /v2 telemetry routes; requires API_V2_ENABLED=true
API_V2_TELEMETRY_ENABLED=false
# /v1 telemetry read implementation: legacy (water_quality) or v2 (observation_numeric projection)
V1_TELEMETRY_READ_SOURCE=legacy

# Public contact form: fixed one-minute windows per client IP (Redis required)
LEAD_RATE_LIMIT_PER_MINUTE=5
